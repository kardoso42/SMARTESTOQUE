rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function profile() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function isActive() {
      return hasProfile() && profile().ativo == true;
    }

    function isChefe() {
      return isActive() && profile().cargo == 'CHEFE';
    }

    function isOperador() {
      return isActive() && profile().cargo == 'OPERADOR';
    }

    function hasPermission(permission) {
      return isActive()
        && profile().get('permissoes', {}).get(permission, false) == true;
    }

    function podeConsultarFichas() {
      return isChefe()
        || (isActive()
          && profile().get('permissoes', {})
            .get('fichasTecnicas', {}).get('consultar', false) == true);
    }

    function podeEditarFichas() {
      return isChefe()
        || (isActive()
          && profile().get('permissoes', {})
            .get('fichasTecnicas', {}).get('editar', false) == true);
    }

    match /usuarios/{userId} {
      allow read: if isChefe()
        || (signedIn() && request.auth.uid == userId);

      allow create: if isChefe()
        && request.resource.data.keys().hasAll([
          'nome', 'email', 'cargo', 'ativo', 'permissoes'
        ])
        && request.resource.data.cargo in ['CHEFE', 'OPERADOR']
        && request.resource.data.ativo is bool
        && request.resource.data.nome is string
        && request.resource.data.email is string;

      allow update: if isChefe()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'nome', 'cargo', 'ativo', 'permissoes',
            'atualizadoEm', 'atualizadoPor'
          ])
        && request.resource.data.cargo in ['CHEFE', 'OPERADOR']
        && request.resource.data.ativo is bool
        && request.resource.data.nome is string
        && (
          userId != request.auth.uid
          || (
            request.resource.data.cargo == 'CHEFE'
            && request.resource.data.ativo == true
          )
        );

      allow delete: if false;
    }

    match /catalogo/{documentId} {
      allow read: if isChefe() || isOperador();
      allow create: if hasPermission('cadastrarProduto');
      allow delete: if hasPermission('excluirProduto');
      allow update: if hasPermission('alterarProduto')
        || (
          isOperador()
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['gtin'])
        );
    }

    match /contagens/{documentId} {
      allow read: if isChefe() || isOperador();

      allow create: if (
        isChefe()
        && request.resource.data.uid == request.auth.uid
      ) || (
        isOperador()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.obs != 'REGISTO ZERADO AUTOMATICAMENTE'
      );

      allow update: if isChefe()
        || (
          isOperador()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
        );

      allow delete: if isChefe()
        || (
          isOperador()
          && resource.data.uid == request.auth.uid
        );
    }

    match /fichasTecnicas/{fichaId} {
      allow read: if podeConsultarFichas();
      allow create, update, delete: if podeEditarFichas();
    }

    match /historicoCustos/{historicoId} {
      allow read: if podeConsultarFichas();
      allow create: if podeEditarFichas()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}