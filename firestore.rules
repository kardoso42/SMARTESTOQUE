rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function perfilExiste() {
      return signedIn() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function perfilAtual() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function isChefe() {
      return perfilExiste() && perfilAtual().cargo == 'CHEFE';
    }

    function podeConsultarFichas() {
      return isChefe() ||
        (perfilExiste() &&
          perfilAtual().permissoes.fichasTecnicas.consultar == true);
    }

    function podeEditarFichas() {
      return isChefe() ||
        (perfilExiste() &&
          perfilAtual().permissoes.fichasTecnicas.editar == true);
    }

    match /usuarios/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isChefe());
      allow create, delete: if false;
      // O CHEFE só pode alterar o mapa de permissões da funcionalidade de fichas.
      allow update: if isChefe()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['permissoes'])
        && request.resource.data.permissoes.diff(resource.data.permissoes).affectedKeys().hasOnly(['fichasTecnicas']);
    }

    match /catalogo/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if isChefe();
    }

    match /contagens/{docId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if isChefe()
        || (signedIn()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid);
      allow delete: if isChefe()
        || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /fichasTecnicas/{fichaId} {
      allow read: if podeConsultarFichas();
      allow create, update, delete: if podeEditarFichas();
    }

    match /historicoCustos/{historicoId} {
      allow read: if podeConsultarFichas();
      allow create: if podeEditarFichas()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}